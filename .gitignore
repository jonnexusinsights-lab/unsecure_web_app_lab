# ==========================================
# InsecurePay - .gitignore
# Proyecto Full-Stack: Spring Boot + Angular
# ==========================================

# --- Java & Spring Boot (Backend) ---
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Wrapper & Cache
backend/.mvn/timing.properties
.mvn/timing.properties

# Logs
*.log
backend/*.log
frontend/*.log
logs/

# H2 Database file engine (en caso de pruebas en disco)
*.mv.db
*.trace.db

# --- Node.js & Angular (Frontend) ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.angular/
frontend/.angular/
.angular/cache/
frontend/.angular/cache/

# NPM & Yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Cypress / Test coverage
/coverage/
frontend/coverage/

# --- IDEs & Editores de Código ---
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.nb-gradle/

# Nota: Se mantienen las configuraciones compartidas de .vscode/ (tasks.json, launch.json, settings.json)
# pero se ignoran caches y estados locales
.vscode/*.log
.vscode/.ropeproject
*.suo
*.ntvs*
*.njsproj
*.user

# --- Sistema Operativo (Windows & macOS) ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

